# ==============================================================================
# Enterprise AI Knowledge Management - Environment Configuration
# ==============================================================================

# LLM Provider: 'gemini', 'openai', 'groq', or 'mock' (for local offline testing)
LLM_PROVIDER=gemini

# API Keys (Provide according to selected LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
DEFAULT_GEMINI_MODEL=gemini-1.5-flash
DEFAULT_OPENAI_MODEL=gpt-4o-mini
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model: 'all-MiniLM-L6-v2', 'text-embedding-3-small', or 'local-fast'
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store Settings
CHROMA_PERSIST_DIRECTORY=./data/vector_store
CHROMA_COLLECTION_NAME=enterprise_knowledge_base

# Agent & RAG Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.35
MAX_AGENT_ITERATIONS=3
ENABLE_HALLUCINATION_VALIDATION=true
ENABLE_SAFETY_GUARDRAILS=true
